{
  "name": "class-timer",
  "productName": "우리반타이머",
  "version": "1.0.0",
  "description": "우리반 타이머 - 스톱워치, 타이머, 알람, 세계시각",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "author": "우리반",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.school.classtimer",
    "productName": "우리반타이머",
    "files": ["main.js", "index.html"],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": { "artifactName": "우리반타이머-포터블.exe" },
    "nsis": {
      "artifactName": "우리반타이머-설치.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
